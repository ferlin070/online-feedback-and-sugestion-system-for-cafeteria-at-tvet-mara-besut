rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is admin via Firestore
    function isAdmin() {
      return request.auth != null && 
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Peraturan keselamatan Storage untuk maklum balas gambar
    match /feedback_photos/{imageId} {
      allow create: if request.resource.size < 5 * 1024 * 1024 
                    && request.resource.contentType.matches('image/.*');
      allow read: if true; // Public perlu baca untuk paparkan gambar dalam maklum balas
      allow update, delete: if isAdmin(); // Hanya admin boleh mengemas kini atau memadam gambar
    }

    // Peraturan keselamatan Storage untuk kod QR lokasi
    match /qr_codes/{qrId} {
      allow read: if true; // Public dibenarkan BACA untuk paparan dan muat turun
      allow write: if isAdmin(); // Hanya admin berdaftar boleh jana/muat naik kod QR
    }
  }
}
